# Supabase connection
#
# Find these in the Supabase dashboard under Settings -> API.
#
# SUPABASE_SECRET_KEY is the secret key (sb_secret_..., formerly service_role).
# It bypasses row level security entirely -- it is the database admin key.
# It belongs on the server ONLY. Never put it in frontend/.env, and never
# prefix it with VITE_, because Vite inlines those into the browser bundle.
#
# Copy this file to .env and fill in the real values. .env is gitignored.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your_key_here
